flowchart TD
  SW["软件交付物：程序、数据、相关文档"] --> SYS["按作用：系统软件"]
  SW --> APP["按作用：应用软件"]
  SYS --> OS["操作系统：管理资源与提供接口"]
  SYS --> DBMS["DBMS：管理有组织的数据"]
  SYS --> LANG["语言处理程序：编译/解释"]
  SYS --> NET["网络支撑软件：实现协议"]
  APP --> GEN["通用：浏览器、电子表格"]
  APP --> CUSTOM["专用：校园预约服务"]
  CUSTOM -. "本例通过接口请求存取" .-> DBMS
  DBMS -. "本例文件存取依赖" .-> OS
  CUSTOM -. "本例执行与资源管理依赖" .-> OS
  LANG -. "编译例：开发时处理源程序" .-> CUSTOM
