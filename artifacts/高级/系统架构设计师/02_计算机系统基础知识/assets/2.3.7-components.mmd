flowchart TD
  CLIENT["客户端：按接口发起调用"] --> STUB["存根：请求编码与代理"]
  STUB --> ORB["ORB：请求通信与分派基础"]
  ORB --> POA["服务器端 POA：对象引用与实现适配<br/>按策略激活和定位"]
  POA --> S["Servant：执行对象操作"]
  IF["接口仓库：保存接口描述"] -. "提供接口描述（示意）" .-> ORB
  SERV["公共对象服务：命名、事务等"] -. "通信依赖 ORB" .-> ORB
  CC["构件契约：提供/需要接口、约束、版本"] -. "复用时逐项核对" .-> CLIENT
